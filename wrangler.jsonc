{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tabletop-voice-web",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "worker.js"
}
